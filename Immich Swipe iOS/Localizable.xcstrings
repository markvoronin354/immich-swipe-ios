    "The server refused some changes. Check that your Immich API key has every permission Immich Swipe needs (see the README)." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El servidor rechazó algunos cambios. Compruebe que su clave API de Immich tenga todos los permisos que necesita Immich Swipe (consulte el README)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le serveur a refusé certaines modifications. Vérifiez que votre clé API Immich a toutes les permissions dont Immich Swipe a besoin (voir le README)."
          }
        }
      }
    },
    "The server rejected this API key. Check that it was copied in full and hasn't been deleted." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El servidor ha rechazado esta clave API. Comprueba que la hayas copiado completa y que no se haya eliminado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le serveur a refusé cette clé d’API. Vérifiez qu’elle a été copiée en entier et qu’elle n’a pas été supprimée."
          }
        }
      }
    },
    "The toolbar and tap gestures will go back to their defaults." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
