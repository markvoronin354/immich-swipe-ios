    "Are you sure you want to remove the account for \"%@\"? Its key is deleted from this device. Your server isn't changed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "¿Seguro que quieres eliminar la cuenta de «%@»? Su clave se borrará de este dispositivo. El servidor no se modifica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Voulez-vous vraiment supprimer le compte « %@ » ? Sa clé est effacée de cet appareil. Votre serveur n’est pas modifié."
          }
        }
      }
    },
    "Are you sure you want to sign out of this account? You can sign back in with the same key." : {
