    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Immich Swipe connects to your Immich server, which may be on your local network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Immich Swipe se conecta a tu servidor Immich, que puede estar en tu red local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Immich Swipe se connecte à votre serveur Immich, qui peut se trouver sur votre réseau local."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Immich Swipe saves photos and videos you download from your Immich server to your Photos library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Immich Swipe guarda en la fototeca de Fotos las fotos y vídeos que descargas de tu servidor Immich."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Immich Swipe enregistre dans votre photothèque Photos les photos et vidéos que vous téléchargez depuis votre serveur Immich."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When \"Sync deletion with device\" is on, Immich Swipe looks for the photos you delete from Immich in your Photos library, so it can offer to delete them from this device too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Si «Sincronizar eliminación con el dispositivo» está activado, Immich Swipe busca en la fototeca de Fotos las fotos que eliminas de Immich para ofrecerte eliminarlas también de este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lorsque « Synchroniser la suppression avec l’appareil » est activé, Immich Swipe recherche dans votre photothèque Photos les photos que vous supprimez d’Immich, afin de vous proposer de les supprimer aussi de cet appareil."
          }
        }
      }
    }
  },
  "version" : "1.3"
}