    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Immich Swipe connects to your Immich server, which may be on your local network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Immich Swipe se conecta a tu servidor Immich, que puede estar en tu red local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Immich Swipe se connecte à votre serveur Immich, qui peut se trouver sur votre réseau local."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Immich Swipe saves photos and videos you download from your Immich server to your Photos library. It never reads your library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Immich Swipe guarda en la fototeca de Fotos las fotos y vídeos que descargas de tu servidor Immich. Nunca lee tu fototeca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Immich Swipe enregistre dans votre photothèque Photos les photos et vidéos que vous téléchargez depuis votre serveur Immich. Immich Swipe ne lit jamais votre photothèque."
          }
        }
      }
    }
  },
  "version" : "1.3"
